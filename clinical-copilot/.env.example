# Copy to .env and fill in. See README.md for how to get each value.

OPENEMR_BASE_URL=https://localhost:9300
# OPENEMR_FHIR_BASE_URL and OPENEMR_OAUTH_TOKEN_URL default from OPENEMR_BASE_URL;
# override only if your FHIR/OAuth paths differ.

# From `openemr-cmd worktree exec ... e` (or docker compose exec openemr) after
# registering + enabling a client -- see README.md "Local setup".
OPENEMR_OAUTH_CLIENT_ID=
OPENEMR_OAUTH_CLIENT_SECRET=

# Password-grant credential -- eval suite only (evals/run_evals.py), which has
# no browser to complete an interactive login. Never used by the live /chat
# or /ui path: those use a real per-resident authorization_code login instead
# (see README.md "Local setup" step 1, app/oauth_session.py).
OPENEMR_OAUTH_USERNAME=admin
OPENEMR_OAUTH_PASSWORD=pass

# Only for a self-signed local dev cert (docker/development-easy). Never set
# to false against a real deployment.
OPENEMR_VERIFY_TLS=false

# Where this app itself is reachable -- must match a redirect_uri registered
# on the OAuth client above (README.md "Local setup" step 1).
COPILOT_BASE_URL=http://localhost:8420

# Optional. A dedicated low-privilege demo account (see README.md "Local
# setup" step 2) used only by evals/cases.py's oauth_scope_enforcement_denied
# case and for manual scope-restriction verification -- never a real
# resident's credential. That eval case skips (not fails) if left unset.
OPENEMR_SCOPE_TEST_USERNAME=
OPENEMR_SCOPE_TEST_PASSWORD=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Leave blank to disable Langfuse (the app still logs locally). See
# docker/docker-compose.langfuse.yml to run Langfuse locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3300
